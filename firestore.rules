rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function adminDocExists() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/administradores/$(request.auth.token.email));
    }

    function adminDocExistsLowercase() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/administradores/$(request.auth.token.email.lower()));
    }

    function isAdmin() {
      return adminDocExists() || adminDocExistsLowercase();
    }

    match /products/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /orders/{docId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /admins/{docId} {
      allow read, write: if isAdmin();
    }

    match /administradores/{docId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    match /{collName}/{docId} {
      allow read: if collName == "padrão" || collName == "settings";
      allow write: if (collName == "padrão" || collName == "settings") && isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
